# 复制本文件为 .env 后填写。未填写时系统走本地 fallback 规则，照常可跑。
# 接入 Dify 后，Key 在对应工作流的「访问 API」页面获取。

# ---- Dify AI 大脑 ----
DIFY_BASE_URL=
DIFY_KEY_WF1=
DIFY_KEY_WF2=
DIFY_KEY_WF3=
DIFY_KEY_WF4=
DIFY_KEY_WF5=

# ---- 数据库（上线切 MySQL 时取消注释）----
# DB_URL=mysql+pymysql://user:password@localhost:3306/company_agent?charset=utf8mb4

# ---- 安全 ----
JWT_SECRET=please-change-this-secret
