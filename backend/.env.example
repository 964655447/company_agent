# 复制本文件为 .env 后填写。未填 DIFY_AGENT_KEY 时气泡走本地兜底，照常可跑。

# ---- 统一智能体（Dify Agent）----
# 在 Dify 创建 Agent 类型应用 → 添加工作流工具 → 发布 → 复制 API Key
DIFY_BASE_URL=http://localhost/v1
DIFY_AGENT_KEY=

# ---- 数据库（MySQL）----
DB_URL=mysql+pymysql://root:password@127.0.0.1:3306/company_agent

# ---- 安全 ----
JWT_SECRET=please-change-this-secret
